        timestamptz CompletedAt
    }
    GAME_SESSION {
        int GameSessionId PK
        int UserId FK
        int CorrectCount
        int TotalQuestions
        int Points
        int BestStreak
        timestamptz PlayedAt
    }
    BADGE {
        int BadgeId PK
        varchar Code UK
        varchar Label
        varchar Icon
    }
    USER_BADGE {
        int UserId FK
        int BadgeId FK
        timestamptz EarnedAt
    }
    CHECKLIST_ITEM {
        int ChecklistItemId PK
        text Label
    }
    CHECKLIST_RESPONSE {
        int ChecklistItemId PK,FK
        boolean Checked
        int UpdatedByUserId FK
        timestamptz UpdatedAt
    }
    AUDIT_LOG {
        bigint AuditLogId PK
        int UserId FK "nullable"
        varchar Action
        text Detail
        timestamptz Timestamp
    }
