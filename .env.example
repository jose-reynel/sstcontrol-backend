# Copia este archivo a ".env" (ya está en .gitignore) y completa valores reales
# antes de correr "docker compose up". Nunca subas el ".env" real al repo.

POSTGRES_DB=sst_control
POSTGRES_USER=sst_user
POSTGRES_PASSWORD=cambia-esta-clave-por-una-segura

# Genera una llave de al menos 32 caracteres aleatorios, por ejemplo con:
#   openssl rand -base64 48
JWT_KEY=cambia-esta-llave-por-una-de-al-menos-32-caracteres-aleatorios
JWT_ISSUER=SstControlApi
JWT_AUDIENCE=SstControlPwa

ASPNETCORE_ENVIRONMENT=Production
CORS_ORIGEN_PRINCIPAL=https://jose-reynel.github.io
